;;; export-palettes.el --- Export actual face specs for independent checks -*- lexical-binding: t; -*-
(require 'json)
(require 'cl-lib)
(load (expand-file-name "../matugen-theme.el" (file-name-directory load-file-name)) nil t)
(let* ((root (file-name-directory (directory-file-name (file-name-directory load-file-name))))
       (out (expand-file-name "validation.json" root))
       (snapshot (expand-file-name "test/palette-snapshot.conf" root))
       (actual (with-temp-buffer (insert-file-contents snapshot) (buffer-string)))
       (cases `(("actual-dark" . ,actual)
                ("synthetic-light" . "background = #faf8ff\nforeground = #1b1b21\ncursor-color = #454aa0\npalette = 1=#a03050\npalette = 2=#286030\npalette = 3=#785500\npalette = 4=#454aa0\npalette = 5=#743f80\npalette = 6=#006878\n")
                ("synthetic-medium" . "background = #888888\nforeground = #ffffff\ncursor-color = #aaaaaa\npalette = 1=#888888\n")
                ("synthetic-low-accent" . "background = #131318\nforeground = #e4e1e9\ncursor-color = #202025\npalette = 1=#ff7295\n")))
       (matugen-theme-palette 'preset) (matugen-theme-emphasis 'preset)
       (matugen-theme-semantic-colors 'auto) (matugen-theme-heading-scale 1.0)
       rows)
  (dolist (case cases)
    (dolist (profile matugen-theme--profiles)
      (let* ((matugen-theme-style (car profile))
             (roles (matugen-theme--build-roles (matugen-theme--parse-palette (cdr case))))
             (specs (matugen-theme-faces-build roles)))
        (push `((palette . ,(car case)) (style . ,(symbol-name (car profile)))
                (roles . ,roles)
                (faces . ,(vconcat
                           (mapcar
                            (lambda (entry)
                              (let ((attrs (cadar (cadr entry))))
                                `((name . ,(symbol-name (car entry)))
                                  (fg . ,(plist-get attrs :foreground))
                                  (bg . ,(plist-get attrs :background))
                                  (weight . ,(format "%s" (plist-get attrs :weight)))
                                  (height . ,(or (plist-get attrs :height) 1.0))))) specs)))) rows))))
  (setq rows (nreverse rows))
  (with-temp-file out
    (insert (json-encode `((emacs-version . ,emacs-version) (rows . ,(vconcat rows))))))
  (princ (format "Exported %d palette/profile combinations\n" (length rows))))
